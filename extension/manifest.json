{
  "manifest_version": 3,
  "name": "ygo-th — คำแปลการ์ดภาษาไทย",
  "version": "2.2.2",
  "description": "แสดงคำแปลภาษาไทยของข้อความการ์ดบน Dueling Nexus จากฐานคำแปลเปิด ygo-th (โปรเจกต์แฟน ไม่เกี่ยวข้องกับ Konami)",
  "minimum_chrome_version": "137",
  "permissions": ["storage", "unlimitedStorage", "alarms"],
  "host_permissions": [
    "https://duelingnexus.com/*",
    "https://*.duelingnexus.com/*",
    "https://prachpawee-tang.github.io/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://duelingnexus.com/*", "https://*.duelingnexus.com/*"],
      "js": ["format.js", "content.js"],
      "css": ["styles.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ygo-th"
  }
}
